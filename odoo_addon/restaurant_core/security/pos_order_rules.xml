<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ===================================================================== -->
    <!-- RÈGLES DE SÉCURITÉ D'ISOLATION DES VENTES PAR GÉRANT                    -->
    <!-- Chaque gérant voit UNIQUEMENT ses propres commandes et ventes         -->
    <!-- L'administrateur supervise et voit l'ensemble des ventes de tous       -->
    <!-- ===================================================================== -->

    <!-- 1. Gérant : Accès restreint uniquement à ses propres commandes pos.order -->
    <record id="pos_order_rule_gerant_own_orders" model="ir.rule">
        <field name="name">Gérant Restaurant: voir uniquement ses propres commandes et ventes</field>
        <field name="model_id" ref="point_of_sale.model_pos_order"/>
        <field name="groups" eval="[(4, ref('point_of_sale.group_pos_user'))]"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
    </record>

    <!-- 2. Administrateur : Visibilité globale sur toutes les commandes pos.order -->
    <record id="pos_order_rule_admin_all_orders" model="ir.rule">
        <field name="name">Admin Restaurant: voir toutes les commandes de tous les gérants</field>
        <field name="model_id" ref="point_of_sale.model_pos_order"/>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
