<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ===================================================================== -->
    <!-- RÈGLES DE SÉCURITÉ D'ISOLATION DES VENTES PAR GÉRANT                    -->
    <!-- Chaque gérant voit UNIQUEMENT ses propres commandes et ventes         -->
    <!-- L'administrateur supervise et voit l'ensemble des ventes de tous       -->
    <!-- ===================================================================== -->

    <!-- 1. Gérant : Accès restreint uniquement à ses propres commandes pos.order -->
    <record id="pos_order_rule_gerant_own_orders" model="ir.rule">
        <field name="name">Gérant Restaurant: voir uniquement ses propres commandes et ventes</field>
        <field name="model_id" ref="point_of_sale.model_pos_order"/>
        <field name="groups" eval="[(4, ref('point_of_sale.group_pos_user'))]"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
    </record>

    <!-- 2. Administrateur : Visibilité globale sur toutes les commandes pos.order -->
    <record id="pos_order_rule_admin_all_orders" model="ir.rule">
        <field name="name">Admin Restaurant: voir toutes les commandes de tous les gérants</field>
        <field name="model_id" ref="point_of_sale.model_pos_order"/>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- 3. Gérant : Accès restreint uniquement à ses propres factures Grand Marché -->
    <record id="grand_marche_rule_gerant_own" model="ir.rule">
        <field name="name">Gérant Restaurant: voir uniquement ses propres Grands Marchés</field>
        <field name="model_id" ref="restaurant_core.model_restaurant_grand_marche"/>
        <field name="groups" eval="[(4, ref('point_of_sale.group_pos_user')), (4, ref('point_of_sale.group_pos_manager'))]"/>
        <field name="domain_force">[('manager_id', '=', user.id)]</field>
    </record>

    <!-- 4. Administrateur : Visibilité globale sur tous les Grands Marchés -->
    <record id="grand_marche_rule_admin_all" model="ir.rule">
        <field name="name">Admin Restaurant: voir tous les Grands Marchés de tous les gérants</field>
        <field name="model_id" ref="restaurant_core.model_restaurant_grand_marche"/>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- 5. Gérant : Lignes de Grand Marché restreintes à ses propres marchés -->
    <record id="grand_marche_line_rule_gerant_own" model="ir.rule">
        <field name="name">Gérant Restaurant: voir uniquement ses propres lignes de Grand Marché</field>
        <field name="model_id" ref="restaurant_core.model_restaurant_grand_marche_line"/>
        <field name="groups" eval="[(4, ref('point_of_sale.group_pos_user')), (4, ref('point_of_sale.group_pos_manager'))]"/>
        <field name="domain_force">[('marche_id.manager_id', '=', user.id)]</field>
    </record>

    <!-- 6. Administrateur : Visibilité globale sur toutes les lignes de Grand Marché -->
    <record id="grand_marche_line_rule_admin_all" model="ir.rule">
        <field name="name">Admin Restaurant: voir toutes les lignes de Grand Marché</field>
        <field name="model_id" ref="restaurant_core.model_restaurant_grand_marche_line"/>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
