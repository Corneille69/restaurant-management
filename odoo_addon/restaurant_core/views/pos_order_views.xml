<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_order_form_inherit_restaurant_core" model="ir.ui.view">
        <field name="name">pos.order.form.inherit.restaurant.core</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='session_id']" position="after">
                <field name="backend_order_id" readonly="1"/>
                <field name="backend_table_number" readonly="1"/>
                <field name="backend_sync_status" readonly="1" widget="badge"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <group string="Détails Encaissement Gérant &amp; Monnaie (Sans Monnaie)">
                    <group>
                        <field name="net_paid_amount" string="Net Encaissé sans Monnaie (FCFA)" decoration-bf="1" readonly="1"/>
                        <field name="tendered_amount" string="Montant Versé Client (FCFA)" readonly="1"/>
                        <field name="change_amount" string="Monnaie Rendue (FCFA)" readonly="1"/>
                    </group>
                    <group>
                        <field name="payment_method_name" string="Mode de Paiement Principal" readonly="1"/>
                        <field name="user_id" string="Gérant ayant Encaissé" readonly="1"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_pos_order_tree_inherit_restaurant_core" model="ir.ui.view">
        <field name="name">pos.order.tree.inherit.restaurant.core</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="backend_order_id" optional="hide"/>
                <field name="backend_table_number" optional="show" string="Table"/>
                <field name="payment_method_name" optional="show" string="Mode Paiement"/>
            </xpath>
            <xpath expr="//field[@name='amount_total']" position="before">
                <field name="tendered_amount" optional="show" string="Montant Versé"/>
                <field name="change_amount" optional="show" string="Monnaie Rendue"/>
            </xpath>
            <xpath expr="//field[@name='amount_total']" position="attributes">
                <attribute name="string">NetEncaissé (Sans Monnaie)</attribute>
                <attribute name="decoration-bf">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>